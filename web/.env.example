# Salin ke .env.local lalu isi. Jangan commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=    # atau NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=               # server saja, jangan beri prefix NEXT_PUBLIC_
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
NEXT_PUBLIC_DEMO_MODE=true

# Akun untuk tombol "Masuk sebagai ... Demo". Dibaca hanya di server.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_DOCTOR_EMAIL=
DEMO_DOCTOR_PASSWORD=
